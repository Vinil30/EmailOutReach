MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=OutReach
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=20000
MONGO_SOCKET_TIMEOUT_MS=20000
REQUIRE_MONGO_ON_STARTUP=false
APP_ENV=development
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ALLOW_ORIGINS=*

GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
search_api_key=replace-with-tavily-api-key

GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/gmail/callback
GMAIL_SEND_TIMEOUT_SECONDS=20
GMAIL_MAX_SEND_ATTEMPTS=3
GMAIL_RETRY_BASE_SECONDS=1

SEND_GAP_MIN_SECONDS=60
SEND_GAP_MAX_SECONDS=180

ADMIN_EMAILS=you@example.com
# Prices, recruiters per purchase, the free allowance and the daily cap are set in Admin -> Pricing & limits.
PRO_URL=https://srotabase.com/@vmarena/mailzen-pro
PREMIUM_URL=https://srotabase.com/@vmarena/email-automation-premium
PLAN_DAYS=30
BATCH_PROCESS_START_DELAY_SECONDS=30
REJECTED_EMAILS_DIR=database/rejected
PORT=8000

# Optional: your public site address (e.g. https://your-app.onrender.com) to stop free hosting from sleeping.
KEEP_ALIVE_URL=
# Optional: ZeroBounce API key; enables Admin > Verify emails (mailbox check that catches "Address not found").
EMAIL_VERIFY_API_KEY=

# Credits are bought through Razorpay (test keys rzp_test_... work the same way). Webhook URL: https://<your-site>/api/razorpay/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Serper.dev API key for the marketplace web search (cheapest Google results).
SERPER_API_KEY=
